<Window x:Class="FF11MacroOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FF11MacroOrganizer.Core"
        Title="FF11 Macro Organizer"
        Width="1320" Height="720"
        MinWidth="1080" MinHeight="600"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="#F3F4F6"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="SegmentRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Margin="10" AllowDrop="True" PreviewDragOver="RootGrid_PreviewDragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 上部ツールバー -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenFolder"
                            Content="{Binding [BtnOpenFolder], Source={x:Static core:Loc.Instance}}"
                            Padding="10,5" Margin="0,0,6,0" Click="BtnOpenFolder_Click"/>
                    <Button x:Name="BtnUndo"
                            Content="{Binding [BtnUndo], Source={x:Static core:Loc.Instance}}"
                            Padding="8,5" Margin="0,0,4,0" IsEnabled="False" Click="BtnUndo_Click"/>
                    <Button x:Name="BtnRedo"
                            Content="{Binding [BtnRedo], Source={x:Static core:Loc.Instance}}"
                            Padding="8,5" Margin="0,0,8,0" IsEnabled="False" Click="BtnRedo_Click"/>
                    <Button x:Name="BtnSave"
                            Content="{Binding [BtnSave], Source={x:Static core:Loc.Instance}}"
                            Padding="12,5" Margin="0,0,8,0" FontWeight="Bold"
                            Background="#E5E7EB" Foreground="#6B7280" BorderThickness="0"
                            IsEnabled="False" Click="BtnSave_Click"/>
                </StackPanel>

                <!-- 右側: 言語切替 & 表示モード切替 & pol.exe 監視ステータス -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnLangSwitch"
                            Content="{Binding [BtnLangSwitch], Source={x:Static core:Loc.Instance}}"
                            ToolTip="{Binding [BtnLangSwitchTooltip], Source={x:Static core:Loc.Instance}}"
                            MinWidth="46"
                            Padding="8,4"
                            Margin="0,0,8,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#374151"
                            Background="#F9FAFB"
                            BorderBrush="#CBD5E1"
                            Cursor="Hand"
                            Click="BtnLangSwitch_Click"/>

                    <Border Background="#E5E7EB" CornerRadius="6" Padding="2" Margin="0,0,8,0"
                            ToolTip="{Binding [PaneModeTooltip], Source={x:Static core:Loc.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbSinglePane"
                                         GroupName="PaneMode"
                                         Content="{Binding [RbSinglePane], Source={x:Static core:Loc.Instance}}"
                                         Style="{StaticResource SegmentRadioButtonStyle}"
                                         Click="RbSinglePane_Click"/>
                            <RadioButton x:Name="RbDualPane"
                                         GroupName="PaneMode"
                                         Content="{Binding [RbDualPane], Source={x:Static core:Loc.Instance}}"
                                         IsChecked="True"
                                         Style="{StaticResource SegmentRadioButtonStyle}"
                                         Click="RbDualPane_Click"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PolStatusBadge" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="8,4">
                        <TextBlock x:Name="TxtPolStatus"
                                   Text="{Binding [PolNotRunning], Source={x:Static core:Loc.Instance}}"
                                   Foreground="#166534" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. メインエリア（左ペイン / 中央ブックコピー / 右ペイン） -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColCenter" Width="98"/>
                <ColumnDefinition x:Name="ColRight" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左ペイン -->
            <Border x:Name="LeftPaneBorder" Grid.Column="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="BtnClearLeft"
                                    DockPanel.Dock="Right"
                                    Content="{Binding [BtnClear], Source={x:Static core:Loc.Instance}}"
                                    FontSize="11"
                                    Padding="8,2"
                                    Foreground="#B91C1C"
                                    Background="#FEF2F2"
                                    BorderBrush="#FECACA"
                                    Cursor="Hand"
                                    ToolTip="{Binding [BtnClearTooltip], Source={x:Static core:Loc.Instance}}"
                                    Click="BtnClearLeft_Click"
                                    IsEnabled="False"/>
                            <TextBlock x:Name="TxtLeftPaneTitle"
                                       Text="{Binding [PaneTitleLeft], Source={x:Static core:Loc.Instance}}"
                                       FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtLeftDirty" Text="" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,6,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [LblChar], Source={x:Static core:Loc.Instance}}" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="12"/>
                                <ComboBox x:Name="CmbLeftChar" Width="138" Margin="0,0,2,0" SelectionChanged="LeftChar_SelectionChanged"/>
                                <Button x:Name="BtnRenameLeftChar" Content="✎" Width="22"
                                        ToolTip="{Binding [BtnRenameCharTooltip], Source={x:Static core:Loc.Instance}}"
                                        Click="BtnRenameLeftChar_Click" IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,6,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [LblBook], Source={x:Static core:Loc.Instance}}" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="12"/>
                                <ComboBox x:Name="CmbLeftBook" Width="116" Margin="0,0,2,0" SelectionChanged="LeftBook_SelectionChanged"/>
                                <Button x:Name="BtnRenameLeftBook" Content="✎" Width="22"
                                        ToolTip="{Binding [BtnRenameBookTooltip], Source={x:Static core:Loc.Instance}}"
                                        Click="BtnRenameLeftBook_Click" IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [LblPage], Source={x:Static core:Loc.Instance}}" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="12"/>
                                <Button Content="▲" Width="22" Margin="0,0,2,0"
                                        ToolTip="{Binding [BtnPrevPageTooltip], Source={x:Static core:Loc.Instance}}"
                                        Click="LeftPrevPage_Click"/>
                                <ComboBox x:Name="CmbLeftPage" Width="64" Margin="0,0,2,0" SelectionChanged="LeftPage_SelectionChanged"/>
                                <Button Content="▼" Width="22"
                                        ToolTip="{Binding [BtnNextPageTooltip], Source={x:Static core:Loc.Instance}}"
                                        Click="LeftNextPage_Click"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <!-- 10x2 マクロスロットグリッド（ウィンドウサイズに合わせて縦横に自動拡大） -->
                    <UniformGrid x:Name="GridLeftSlots" Rows="2" Columns="10" Height="140" SizeChanged="SlotGrid_SizeChanged"/>
                </DockPanel>
            </Border>

            <!-- 中央コピーパネル -->
            <StackPanel x:Name="CenterCopyPanel" Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                <StackPanel.Resources>
                    <Style x:Key="CopyArrowButtonStyle" TargetType="Button">
                        <Setter Property="Height" Value="42"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>

                <!-- パレット単位（1ページ） -->
                <TextBlock Text="{Binding [CopyPageHeader], Source={x:Static core:Loc.Instance}}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#475569"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <Button x:Name="BtnCopyPageLeftToRight"
                        Style="{StaticResource CopyArrowButtonStyle}"
                        ToolTip="{Binding [CopyPageL2RTooltip], Source={x:Static core:Loc.Instance}}"
                        Click="BtnCopyPageLeftToRight_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Path Data="M 0,6 L 20,6 L 20,1 L 32,10 L 20,19 L 20,14 L 0,14 Z"
                              Fill="#2563EB"
                              Width="32" Height="20" Stretch="Uniform"/>
                        <TextBlock Text="{Binding [CopyPageSub], Source={x:Static core:Loc.Instance}}"
                                   FontSize="10" Foreground="#475569" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnCopyPageRightToLeft"
                        Style="{StaticResource CopyArrowButtonStyle}"
                        Margin="0,0,0,10"
                        ToolTip="{Binding [CopyPageR2LTooltip], Source={x:Static core:Loc.Instance}}"
                        Click="BtnCopyPageRightToLeft_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Path Data="M 32,6 L 12,6 L 12,1 L 0,10 L 12,19 L 12,14 L 32,14 Z"
                              Fill="#0D9488"
                              Width="32" Height="20" Stretch="Uniform"/>
                        <TextBlock Text="{Binding [CopyPageSub], Source={x:Static core:Loc.Instance}}"
                                   FontSize="10" Foreground="#475569" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </Button>

                <Separator Margin="6,2,6,10" Background="#CBD5E1"/>

                <!-- ブック単位（全10ページ） -->
                <TextBlock Text="{Binding [CopyBookHeader], Source={x:Static core:Loc.Instance}}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#475569"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <Button x:Name="BtnCopyBookLeftToRight"
                        Style="{StaticResource CopyArrowButtonStyle}"
                        ToolTip="{Binding [CopyBookL2RTooltip], Source={x:Static core:Loc.Instance}}"
                        Click="BtnCopyBookLeftToRight_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Path Data="M 0,2 L 13,10 L 0,18 L 0,13 L 5,10 L 0,7 Z M 14,2 L 27,10 L 14,18 L 14,13 L 19,10 L 14,7 Z"
                              Fill="#2563EB"
                              Width="32" Height="20" Stretch="Uniform"/>
                        <TextBlock Text="{Binding [CopyBookSub], Source={x:Static core:Loc.Instance}}"
                                   FontSize="10" Foreground="#475569" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnCopyBookRightToLeft"
                        Style="{StaticResource CopyArrowButtonStyle}"
                        Margin="0"
                        ToolTip="{Binding [CopyBookR2LTooltip], Source={x:Static core:Loc.Instance}}"
                        Click="BtnCopyBookRightToLeft_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Path Data="M 27,2 L 14,10 L 27,18 L 27,13 L 22,10 L 27,7 Z M 13,2 L 0,10 L 13,18 L 13,13 L 8,10 L 13,7 Z"
                              Fill="#0D9488"
                              Width="32" Height="20" Stretch="Uniform"/>
                        <TextBlock Text="{Binding [CopyBookSub], Source={x:Static core:Loc.Instance}}"
                                   FontSize="10" Foreground="#475569" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 右ペイン -->
            <Border x:Name="RightPaneBorder" Grid.Column="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="BtnClearRight"
                                    DockPanel.Dock="Right"
                                    Content="{Binding [BtnClear], Source={x:Static core:Loc.Instance}}"
                                    FontSize="11"
                                    Padding="8,2"
                                    Foreground="#B91C1C"
                                    Background="#FEF2F2"
                                    BorderBrush="#FECACA"
                                    Cursor="Hand"
                                    ToolTip="{Binding [BtnClearTooltip], Source={x:Static core:Loc.Instance}}"
                                    Click="BtnClearRight_Click"
                                    IsEnabled="False"/>
                            <TextBlock Text="{Binding [PaneTitleRight], Source={x:Static core:Loc.Instance}}"
                                       FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtRightDirty" Text="" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,6,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [LblChar], Source={x:Static core:Loc.Instance}}" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="12"/>
                                <ComboBox x:Name="CmbRightChar" Width="138" Margin="0,0,2,0" SelectionChanged="RightChar_SelectionChanged"/>
                                <Button x:Name="BtnRenameRightChar" Content="✎" Width="22"
                                        ToolTip="{Binding [BtnRenameCharTooltip], Source={x:Static core:Loc.Instance}}"
                                        Click="BtnRenameRightChar_Click" IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,6,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [LblBook], Source={x:Static core:Loc.Instance}}" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="12"/>
                                <ComboBox x:Name="CmbRightBook" Width="116" Margin="0,0,2,0" SelectionChanged="RightBook_SelectionChanged"/>
                                <Button x:Name="BtnRenameRightBook" Content="✎" Width="22"
                                        ToolTip="{Binding [BtnRenameBookTooltip], Source={x:Static core:Loc.Instance}}"
                                        Click="BtnRenameRightBook_Click" IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [LblPage], Source={x:Static core:Loc.Instance}}" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="12"/>
                                <Button Content="▲" Width="22" Margin="0,0,2,0"
                                        ToolTip="{Binding [BtnPrevPageTooltip], Source={x:Static core:Loc.Instance}}"
                                        Click="RightPrevPage_Click"/>
                                <ComboBox x:Name="CmbRightPage" Width="64" Margin="0,0,2,0" SelectionChanged="RightPage_SelectionChanged"/>
                                <Button Content="▼" Width="22"
                                        ToolTip="{Binding [BtnNextPageTooltip], Source={x:Static core:Loc.Instance}}"
                                        Click="RightNextPage_Click"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <!-- 10x2 マクロスロットグリッド -->
                    <UniformGrid x:Name="GridRightSlots" Rows="2" Columns="10" Height="140"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 3. 選択マクロの6行プレビュー（左右独立黒板） -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColPreviewGap" Width="10"/>
                <ColumnDefinition x:Name="ColPreviewRight" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左プレビュー黒板 -->
            <Border x:Name="LeftPreviewBorder" Grid.Column="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="BtnEditLeftSlot" DockPanel.Dock="Right"
                                Content="{Binding [BtnEdit], Source={x:Static core:Loc.Instance}}"
                                Padding="10,2" FontSize="12" Margin="8,0,0,0"
                                IsEnabled="False" Click="BtnEditLeftSlot_Click"/>
                        <TextBlock x:Name="TxtLeftPreviewHeader"
                                   Text=""
                                   FontWeight="Bold" Foreground="#111827" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <Border Background="#111827" CornerRadius="4" Padding="10,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TxtLeftLineNumbers"
                                           Grid.Column="0"
                                           Text="1:&#x0a;2:&#x0a;3:&#x0a;4:&#x0a;5:&#x0a;6:"
                                           Foreground="#6B7280"
                                           FontFamily="Consolas, BIZ UDGothic, MS Gothic"
                                           FontSize="15"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="22"
                                           VerticalAlignment="Top"
                                           Margin="0,0,8,0"
                                           Visibility="Hidden"
                                           IsHitTestVisible="False"/>

                                <TextBox x:Name="TxtLeftPreviewBody"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         Foreground="#F9FAFB"
                                         BorderThickness="0"
                                         Padding="0"
                                         FontFamily="Consolas, BIZ UDGothic, MS Gothic"
                                         FontSize="15"
                                         TextBlock.LineStackingStrategy="BlockLineHeight"
                                         TextBlock.LineHeight="22"
                                         VerticalAlignment="Top"
                                         TextWrapping="NoWrap"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>

            <!-- 右プレビュー黒板 -->
            <Border x:Name="RightPreviewBorder" Grid.Column="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="BtnEditRightSlot" DockPanel.Dock="Right"
                                Content="{Binding [BtnEdit], Source={x:Static core:Loc.Instance}}"
                                Padding="10,2" FontSize="12" Margin="8,0,0,0"
                                IsEnabled="False" Click="BtnEditRightSlot_Click"/>
                        <TextBlock x:Name="TxtRightPreviewHeader"
                                   Text=""
                                   FontWeight="Bold" Foreground="#64748B" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <Border Background="#111827" CornerRadius="4" Padding="10,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TxtRightLineNumbers"
                                           Grid.Column="0"
                                           Text="1:&#x0a;2:&#x0a;3:&#x0a;4:&#x0a;5:&#x0a;6:"
                                           Foreground="#6B7280"
                                           FontFamily="Consolas, BIZ UDGothic, MS Gothic"
                                           FontSize="15"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="22"
                                           VerticalAlignment="Top"
                                           Margin="0,0,8,0"
                                           Visibility="Hidden"
                                           IsHitTestVisible="False"/>

                                <TextBox x:Name="TxtRightPreviewBody"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         Foreground="#F9FAFB"
                                         BorderThickness="0"
                                         Padding="0"
                                         FontFamily="Consolas, BIZ UDGothic, MS Gothic"
                                         FontSize="15"
                                         TextBlock.LineStackingStrategy="BlockLineHeight"
                                         TextBlock.LineHeight="22"
                                         VerticalAlignment="Top"
                                         TextWrapping="NoWrap"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 4. 下部ステータスバー -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="4,2">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Margin="16,0,0,0"
                           Text="{Binding [FooterHint], Source={x:Static core:Loc.Instance}}"
                           Foreground="#6B7280" FontSize="12"/>
                <TextBlock x:Name="TxtStatusMessage"
                           Text="{Binding [StatusInitialPrompt], Source={x:Static core:Loc.Instance}}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#374151" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>