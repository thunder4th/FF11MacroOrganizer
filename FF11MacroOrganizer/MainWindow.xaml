<Window x:Class="FF11MacroOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FF11 Macro Organizer"
        Width="1320" Height="720"
        MinWidth="1080" MinHeight="600"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="#F3F4F6"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="SegmentRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Margin="10" AllowDrop="True" PreviewDragOver="RootGrid_PreviewDragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 上部ツールバー -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenFolder" Content="フォルダを開く..." Padding="12,5" Margin="0,0,8,0" Click="BtnOpenFolder_Click"/>
                    <Button x:Name="BtnUndo" Content="元に戻す (Ctrl+Z)" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" Click="BtnUndo_Click"/>
                    <Button x:Name="BtnRedo" Content="やり直し (Ctrl+Y)" Padding="10,5" Margin="0,0,14,0" IsEnabled="False" Click="BtnRedo_Click"/>
                    <Button x:Name="BtnSave" Content="変更を保存" Padding="14,5" FontWeight="Bold"
                            Background="#E5E7EB" Foreground="#6B7280" BorderThickness="0"
                            IsEnabled="False" Click="BtnSave_Click"/>
                </StackPanel>

                <!-- 右側: 表示モード切替 & pol.exe 監視ステータス -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E5E7EB" CornerRadius="6" Padding="2" Margin="0,0,12,0"
                            ToolTip="1ペイン（編集集中）と2ペイン（整理・複製）を切り替えます">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbSinglePane"
                                         GroupName="PaneMode"
                                         Content="1ペイン"
                                         Style="{StaticResource SegmentRadioButtonStyle}"
                                         Click="RbSinglePane_Click"/>
                            <RadioButton x:Name="RbDualPane"
                                         GroupName="PaneMode"
                                         Content="2ペイン"
                                         IsChecked="True"
                                         Style="{StaticResource SegmentRadioButtonStyle}"
                                         Click="RbDualPane_Click"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PolStatusBadge" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="10,4">
                        <TextBlock x:Name="TxtPolStatus" Text="● FF11未起動 (保存可能)" Foreground="#166534" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. メインエリア（左ペイン / 中央ブックコピー / 右ペイン） -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColCenter" Width="122"/>
                <ColumnDefinition x:Name="ColRight" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左ペイン -->
            <Border x:Name="LeftPaneBorder" Grid.Column="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="TxtLeftPaneTitle" Text="左パレット" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtLeftDirty" Text="" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="キャラ:" VerticalAlignment="Center" Margin="0,0,4,4" FontSize="12"/>
                            <ComboBox x:Name="CmbLeftChar" Width="155" Margin="0,0,6,4" SelectionChanged="LeftChar_SelectionChanged"/>

                            <TextBlock Text="ブック:" VerticalAlignment="Center" Margin="0,0,4,4" FontSize="12"/>
                            <ComboBox x:Name="CmbLeftBook" Width="130" Margin="0,0,6,4" SelectionChanged="LeftBook_SelectionChanged"/>

                            <TextBlock Text="ページ:" VerticalAlignment="Center" Margin="0,0,4,4" FontSize="12"/>
                            <Button Content="▲" Width="24" Margin="0,0,2,4" ToolTip="前のページへ" Click="LeftPrevPage_Click"/>
                            <ComboBox x:Name="CmbLeftPage" Width="68" Margin="0,0,2,4" SelectionChanged="LeftPage_SelectionChanged"/>
                            <Button Content="▼" Width="24" Margin="0,0,0,4" ToolTip="次のページへ" Click="LeftNextPage_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- 10x2 マクロスロットグリッド（ウィンドウサイズに合わせて縦横に自動拡大） -->
                    <UniformGrid x:Name="GridLeftSlots" Rows="2" Columns="10" Height="140" SizeChanged="SlotGrid_SizeChanged"/>
                </DockPanel>
            </Border>

            <!-- 中央：パレット／ブック単位コピー操作 -->
            <StackPanel x:Name="CenterCopyPanel" Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="パレット単位コピー" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <Button x:Name="BtnCopyPageLeftToRight" Content="左 → 右&#x0a;パレット複製" Padding="4,5" Margin="0,0,0,5"
                        HorizontalContentAlignment="Center" IsEnabled="False" Click="BtnCopyPageLeftToRight_Click"/>
                <Button x:Name="BtnCopyPageRightToLeft" Content="左 ← 右&#x0a;パレット複製" Padding="4,5" Margin="0,0,0,10"
                        HorizontalContentAlignment="Center" IsEnabled="False" Click="BtnCopyPageRightToLeft_Click"/>

                <Separator Margin="4,0,4,10"/>

                <TextBlock Text="ブック単位コピー" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <Button x:Name="BtnCopyBookLeftToRight" Content="左 → 右&#x0a;ブック複製" Padding="4,5" Margin="0,0,0,5"
                        HorizontalContentAlignment="Center" IsEnabled="False" Click="BtnCopyBookLeftToRight_Click"/>
                <Button x:Name="BtnCopyBookRightToLeft" Content="左 ← 右&#x0a;ブック複製" Padding="4,5"
                        HorizontalContentAlignment="Center" IsEnabled="False" Click="BtnCopyBookRightToLeft_Click"/>
            </StackPanel>

            <!-- 右ペイン -->
            <Border x:Name="RightPaneBorder" Grid.Column="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="右パレット" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtRightDirty" Text="" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="キャラ:" VerticalAlignment="Center" Margin="0,0,4,4" FontSize="12"/>
                            <ComboBox x:Name="CmbRightChar" Width="155" Margin="0,0,6,4" SelectionChanged="RightChar_SelectionChanged"/>

                            <TextBlock Text="ブック:" VerticalAlignment="Center" Margin="0,0,4,4" FontSize="12"/>
                            <ComboBox x:Name="CmbRightBook" Width="130" Margin="0,0,6,4" SelectionChanged="RightBook_SelectionChanged"/>

                            <TextBlock Text="ページ:" VerticalAlignment="Center" Margin="0,0,4,4" FontSize="12"/>
                            <Button Content="▲" Width="24" Margin="0,0,2,4" ToolTip="前のページへ" Click="RightPrevPage_Click"/>
                            <ComboBox x:Name="CmbRightPage" Width="68" Margin="0,0,2,4" SelectionChanged="RightPage_SelectionChanged"/>
                            <Button Content="▼" Width="24" Margin="0,0,0,4" ToolTip="次のページへ" Click="RightNextPage_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- 10x2 マクロスロットグリッド -->
                    <UniformGrid x:Name="GridRightSlots" Rows="2" Columns="10" Height="140"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 3. 選択マクロの6行プレビュー（左右独立黒板） -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColPreviewGap" Width="10"/>
                <ColumnDefinition x:Name="ColPreviewRight" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左プレビュー黒板 -->
            <Border x:Name="LeftPreviewBorder" Grid.Column="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="BtnEditLeftSlot" DockPanel.Dock="Right" Content="編集..."
                                Padding="10,2" FontSize="12" Margin="8,0,0,0"
                                IsEnabled="False" Click="BtnEditLeftSlot_Click"/>
                        <TextBlock x:Name="TxtLeftPreviewHeader"
                                   Text="[左] スロットを選択すると内容が表示されます"
                                   FontWeight="Bold" Foreground="#111827" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <Border Background="#111827" CornerRadius="4" Padding="10,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TxtLeftLineNumbers"
                                           Grid.Column="0"
                                           Text="1:&#x0a;2:&#x0a;3:&#x0a;4:&#x0a;5:&#x0a;6:"
                                           Foreground="#6B7280"
                                           FontFamily="Consolas, BIZ UDGothic, MS Gothic"
                                           FontSize="15"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="22"
                                           VerticalAlignment="Top"
                                           Margin="0,0,8,0"
                                           Visibility="Hidden"
                                           IsHitTestVisible="False"/>

                                <TextBox x:Name="TxtLeftPreviewBody"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         Foreground="#F9FAFB"
                                         BorderThickness="0"
                                         Padding="0"
                                         FontFamily="Consolas, BIZ UDGothic, MS Gothic"
                                         FontSize="15"
                                         TextBlock.LineStackingStrategy="BlockLineHeight"
                                         TextBlock.LineHeight="22"
                                         VerticalAlignment="Top"
                                         TextWrapping="NoWrap"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>

            <!-- 右プレビュー黒板 -->
            <Border x:Name="RightPreviewBorder" Grid.Column="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="BtnEditRightSlot" DockPanel.Dock="Right" Content="編集..."
                                Padding="10,2" FontSize="12" Margin="8,0,0,0"
                                IsEnabled="False" Click="BtnEditRightSlot_Click"/>
                        <TextBlock x:Name="TxtRightPreviewHeader"
                                   Text="[右] スロットを選択すると内容が表示されます"
                                   FontWeight="Bold" Foreground="#64748B" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <Border Background="#111827" CornerRadius="4" Padding="10,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TxtRightLineNumbers"
                                           Grid.Column="0"
                                           Text="1:&#x0a;2:&#x0a;3:&#x0a;4:&#x0a;5:&#x0a;6:"
                                           Foreground="#6B7280"
                                           FontFamily="Consolas, BIZ UDGothic, MS Gothic"
                                           FontSize="15"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="22"
                                           VerticalAlignment="Top"
                                           Margin="0,0,8,0"
                                           Visibility="Hidden"
                                           IsHitTestVisible="False"/>

                                <TextBox x:Name="TxtRightPreviewBody"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         Foreground="#F9FAFB"
                                         BorderThickness="0"
                                         Padding="0"
                                         FontFamily="Consolas, BIZ UDGothic, MS Gothic"
                                         FontSize="15"
                                         TextBlock.LineStackingStrategy="BlockLineHeight"
                                         TextBlock.LineHeight="22"
                                         VerticalAlignment="Top"
                                         TextWrapping="NoWrap"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
        
        <!-- 4. 下部ステータスバー -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="4,2">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Margin="16,0,0,0"
                           Text="操作: ダブルクリック＝編集 / Delete＝クリア / ドラッグ＝入れ替え / Ctrl+ドラッグ＝コピー / 右クリック＝メニュー"
                           Foreground="#6B7280" FontSize="12"/>
                <TextBlock x:Name="TxtStatusMessage"
                           Text="「フォルダを開く...」から FF11 の USER フォルダ（またはテスト用フォルダ）を選択してください。"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#374151" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>