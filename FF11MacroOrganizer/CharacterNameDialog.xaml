<Window x:Class="FF11MacroOrganizer.CharacterNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FF11MacroOrganizer.Core"
        Title="{Binding [DlgCharNameTitle], Source={x:Static core:Loc.Instance}}"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F9FAFB">
    <StackPanel Margin="16">
        <TextBlock x:Name="TxtTargetInfo"
                   Text=""
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   Margin="0,0,0,4"/>

        <TextBlock x:Name="TxtDetectedInfo"
                   Text=""
                   FontSize="12"
                   Foreground="#4B5563"
                   Margin="0,0,0,8"
                   Visibility="Collapsed"/>

        <TextBlock Text="{Binding [DlgCharNamePrompt], Source={x:Static core:Loc.Instance}}"
                   FontSize="12"
                   Foreground="#4B5563"
                   Margin="0,0,0,4"/>

        <TextBox x:Name="TxtCharacterName"
                 FontSize="14"
                 Padding="6,4"
                 MaxLength="32"/>

        <TextBlock Text="{Binding [DlgCharNameNote], Source={x:Static core:Loc.Instance}}"
                   FontSize="11"
                   Foreground="#6B7280"
                   Margin="0,6,0,14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk"
                    Content="{Binding [DlgBtnSet], Source={x:Static core:Loc.Instance}}"
                    Width="88"
                    Height="28"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
            <Button Content="{Binding [DlgCancel], Source={x:Static core:Loc.Instance}}"
                    Width="88"
                    Height="28"
                    IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>