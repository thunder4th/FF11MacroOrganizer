<Window x:Class="FF11MacroOrganizer.BookRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ブック名の変更"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F9FAFB">
    <StackPanel Margin="16">
        <TextBlock x:Name="TxtTargetInfo"
                   Text="キャラ / Book 01"
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   Margin="0,0,0,8"/>

        <TextBlock Text="新しいブック名（最大 15 バイト：半角15文字 / 全角7文字）"
                   FontSize="12"
                   Foreground="#4B5563"
                   Margin="0,0,0,4"/>

        <TextBox x:Name="TxtBookTitle"
                 FontSize="14"
                 Padding="6,4"
                 TextChanged="TxtBookTitle_TextChanged"/>

        <DockPanel Margin="0,4,0,12">
            <TextBlock x:Name="TxtByteCount"
                       DockPanel.Dock="Right"
                       Text="0 / 15 バイト"
                       FontSize="12"
                       Foreground="#4B5563"/>
            <TextBlock x:Name="TxtError"
                       Text=""
                       FontSize="12"
                       Foreground="#DC2626"
                       TextWrapping="Wrap"
                       Margin="0,0,8,0"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk"
                    Content="変更"
                    Width="84"
                    Height="28"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
            <Button Content="キャンセル"
                    Width="84"
                    Height="28"
                    IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>