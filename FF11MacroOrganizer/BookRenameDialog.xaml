<Window x:Class="FF11MacroOrganizer.BookRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FF11MacroOrganizer.Core"
        Title="{Binding [DlgRenameBookTitle], Source={x:Static core:Loc.Instance}}"
        Width="390"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F9FAFB">
    <StackPanel Margin="16">
        <TextBlock x:Name="TxtTargetInfo"
                   Text="Book 01"
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   Margin="0,0,0,8"/>

        <TextBlock Text="{Binding [DlgRenameBookPrompt], Source={x:Static core:Loc.Instance}}"
                   FontSize="12"
                   Foreground="#4B5563"
                   Margin="0,0,0,4"/>

        <TextBox x:Name="TxtBookTitle"
                 FontSize="14"
                 Padding="6,4"
                 TextChanged="TxtBookTitle_TextChanged"/>

        <DockPanel Margin="0,4,0,12">
            <TextBlock x:Name="TxtByteCount"
                       DockPanel.Dock="Right"
                       Text="0 / 15"
                       FontSize="12"
                       Foreground="#4B5563"/>
            <TextBlock x:Name="TxtError"
                       Text=""
                       FontSize="12"
                       Foreground="#DC2626"
                       TextWrapping="Wrap"
                       Margin="0,0,8,0"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk"
                    Content="{Binding [DlgBtnRename], Source={x:Static core:Loc.Instance}}"
                    Width="88"
                    Height="28"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
            <Button Content="{Binding [DlgCancel], Source={x:Static core:Loc.Instance}}"
                    Width="88"
                    Height="28"
                    IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>